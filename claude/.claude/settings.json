{
  "env": {
    "DISABLE_ZOXIDE": "1",
    "_ZO_DOCTOR": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(clang-format*)",
      "Bash(cliphist decode *)",
      "Bash(cliphist list *)",
      "Bash(coredumpctl list *)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gh search *)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git describe*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git remote*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(git status*)",
      "Bash(git tag*)",
      "Bash(grep:*)",
      "Bash(hyprctl binds *)",
      "Bash(hyprctl clients *)",
      "Bash(hyprctl getoption *)",
      "Bash(hyprctl monitors *)",
      "Bash(hyprctl version *)",
      "Bash(loginctl show-session *)",
      "Bash(ls:*)",
      "Bash(ocamlfind list)",
      "Bash(opam list *)",
      "Bash(opam show *)",
      "Bash(pacman -Ss *)",
      "Bash(resolvectl query *)",
      "Bash(resolvectl status *)",
      "Bash(rg:*)",
      "Bash(run-clang-tidy*)",
      "Bash(tree:*)",
      "Bash(wpctl get-volume *)",
      "Bash(yay -Si *)",
      "Bash(yay -Ss *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash /home/xiaomin/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true
}
